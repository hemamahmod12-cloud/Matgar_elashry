{
  "name": "matgar_elashry_upgrade",
  "version": "1.0.0",
  "private": true,
  "main": "index.html",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hemamahmod12-cloud/Matgar_elashry.git"
  },
  "homepage": "https://hemamahmod12-cloud.github.io/Matgar_elashry/",
  "description": "Production-ready upgrade for Matgar Elashry store platform",
  "scripts": {
    "lint": "eslint . --ext .js,.cjs,.mjs --ignore-pattern 'node_modules/' --ignore-pattern 'coverage/'",
    "lint:fix": "eslint . --ext .js,.cjs,.mjs --fix --ignore-pattern 'node_modules/' --ignore-pattern 'coverage/'",
    "format": "prettier --write \"**/*.{js,cjs,mjs,json,md,yml,yaml,css,html}\"",
    "format:check": "prettier --check \"**/*.{js,cjs,mjs,json,md,yml,yaml,css,html}\"",
    "test": "jest --coverage --runInBand",
    "test:watch": "jest --watch",
    "migrate:roles": "node scripts/migrate-roles.js",
    "verify:setup": "bash scripts/verify-setup.sh",
    "precommit": "npm run lint && npm run format:check && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "collectCoverageFrom": [
      "src/**/*.js",
      "scripts/**/*.js",
      "!scripts/**/node_modules/**"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 70,
        "functions": 70,
        "lines": 70,
        "statements": 70
      }
    }
  }
}
