{
  "env": {
    "browser": true,
    "es2022": true,
    "node": true
  },
  "extends": ["eslint:recommended"],
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "rules": {
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_"
      }
    ],
    "no-console": [
      "warn",
      {
        "allow": ["warn", "error"]
      }
    ],
    "no-debugger": "error",
    "no-var": "error",
    "prefer-const": "error",
    "eqeqeq": ["error", "always"],
    "curly": "error",
    "no-eval": "error",
    "no-implied-eval": "error",
    "no-new-func": "error",
    "no-script-url": "error",
    "no-prototype-builtins": "error",
    "no-unsafe-optional-chaining": "error",
    "no-throw-literal": "error",
    "require-await": "error",
    "no-return-await": "error",
    "prefer-promise-reject-errors": "error",
    "no-async-promise-executor": "error"
  },
  "overrides": [
    {
      "files": ["tests/**/*.js", "**/*.test.js"],
      "env": {
        "jest": true,
        "mocha": true
      },
      "rules": {
        "no-console": "off"
      }
    },
    {
      "files": ["tests/**/*.js", "**/*.test.js"],
      "env": {
        "jest": true,
        "mocha": true,
        "node": true
      },
      "rules": {
        "no-console": "off",
        "no-script-url": "off",
        "require-await": "off"
      }
    },
    {
      "files": ["scripts/**/*.js"],
      "rules": {
        "no-console": "off"
      }
    }
  ],
  "ignorePatterns": [
    "node_modules/",
    "dist/",
    "build/",
    "coverage/",
    "*.min.js",
    "category-filter-patch.js"
  ]
}
