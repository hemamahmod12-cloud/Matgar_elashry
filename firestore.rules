rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /storeData/{docId} {
      // قراءة مقيدة للمستخدمين المسجلين
      allow read: if signedIn() && docId in ['products','sales','moves','categories','suppliers','parked','invoiceCounter','shifts','settings','expenses','users'];

      // عمليات CRUD الحساسة محصورة بالـ admins
      allow create, update, delete: if isAdmin() && docId in ['products','moves','categories','suppliers','settings','expenses','users','lastAutoBackupAt'];

      // استثناء: السماح لأي مستخدم بإنشاء سجل بيع واحد مع تحقق من الحقول
      match /sales/{saleId} {
        allow create: if signedIn()
          && request.resource.data.keys().hasAll(['id','createdAt','createdBy','items','total'])
          && request.resource.data.createdBy == request.auth.uid;
        allow read: if signedIn();
        allow update, delete: if isAdmin();
      }
    }

    match /{document=**} { allow read, write: if false; }
  }
}
